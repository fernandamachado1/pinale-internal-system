# Local development environment variables
#
# Copy to `.env` (this file is gitignored) and fill the values.

# Deno API (Supabase Postgres)
# Use the "Connection string" from Supabase and append `?sslmode=require`
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase (Auth + JWT validation in the Deno API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Vite (client) env vars
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional (recommended for Vercel): absolute URL of the deployed API
# Example: https://pinale-internal-system-j9x3fwmska0b.fernanda.deno.net
VITE_API_BASE_URL=""

# Local ports
# - `PORT` is the Deno API port
# - `API_PORT` is only used by Vite proxy in `vite.config.ts`
PORT=8001
API_PORT=8001

# Optional debugging / connectivity knobs
# - Many local networks have broken IPv6; leave these enabled for local dev.
PG_FORCE_IPV4=true
DRIZZLE_FORCE_IPV4=true

# SSL verification:
# - For local dev you can keep strict verification OFF (default).
# - In production set this to true.
PG_SSL_REJECT_UNAUTHORIZED=false

# CORS (only needed when the frontend is on another domain, ex: Vercel)
# Comma-separated list of allowed origins. If empty, the API allows all origins.
# Example:
# CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"
CORS_ORIGIN=""
